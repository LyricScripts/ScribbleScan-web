{
  "name": "scribblescan-web",
  "private": true,
  "version": "0.1.0",
  "description": "ScribbleScan budget tracking web app",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "api:types": "npm exec --yes --package=@hey-api/openapi-ts@0.99.0 --package=typescript@6.0.3 -- openapi-ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "21.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.4.2",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  }
}
